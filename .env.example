# Copy this file to .env and fill in your own values.
# .env is in .gitignore — never commit it.

# MongoDB Atlas connection string.
# Atlas: Database -> Connect -> Drivers -> copy the mongodb+srv:// line,
# then replace <password> with the database user's password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Which database inside the cluster to use. Collections products, users and orders
# live inside this one.
MONGODB_DB=baykicks

# Any long random string. Signs the session cookie. Changing it logs everyone out.
SESSION_SECRET=replace-me-with-something-random

# Port the site runs on.
PORT=3000
